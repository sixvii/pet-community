APP_ENV=production
APP_ORIGIN=https://petwebs.web.app
API_ORIGIN=https://your-php-api-service.onrender.com

# Set this to the same Render API origin plus /api/auth/google/callback.
GOOGLE_REDIRECT_URI=https://your-php-api-service.onrender.com/api/auth/google/callback
SESSION_SAME_SITE=None

MONGODB_URI=mongodb+srv://URL_ENCODED_APP_USER:URL_ENCODED_APP_PASSWORD@your-cluster.mongodb.net/pett
MONGODB_DATABASE=pett
MONGODB_USERNAME=URL_SAFE_APP_USERNAME
MONGODB_PASSWORD=URL_SAFE_APP_PASSWORD
MONGO_INITDB_ROOT_USERNAME=unused-on-render
MONGO_INITDB_ROOT_PASSWORD=unused-on-render

POSTS_COLLECTION=posts
FOLLOWS_COLLECTION=follows
MEDICAL_RECORDS_COLLECTION=medical_records
APPOINTMENTS_COLLECTION=appointments
REVIEWS_COLLECTION=provider_reviews
PROVIDERS_COLLECTION=providers
USERS_COLLECTION=users
PETS_COLLECTION=pets
ACCOUNT_DATA_COLLECTION=account_data
CONVERSATIONS_COLLECTION=conversations
MESSAGES_COLLECTION=messages
PROJECTS_COLLECTION=admin_projects
REPORTS_COLLECTION=reports
ADMIN_DATA_ACCESS_AUDIT_COLLECTION=admin_data_access_audit
LOST_FOUND_COLLECTION=lost_found
ADOPTIONS_COLLECTION=adoptions
ADOPTION_APPLICATIONS_COLLECTION=adoption_applications
SAVED_POSTS_COLLECTION=saved_posts
PROVIDER_AVAILABILITY_COLLECTION=provider_availability
PROVIDER_BOOKING_LOCKS_COLLECTION=provider_booking_locks

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
